# Copy to .env and fill in. Never commit .env.

# PostgreSQL. With docker-compose: postgresql://umurongo:umurongo@localhost:5432/umurongo
DATABASE_URL="postgresql://umurongo:umurongo@localhost:5432/umurongo"

# Separate database for the API and end-to-end tests (they re-seed it).
TEST_DATABASE_URL="postgresql://umurongo:umurongo@localhost:5432/umurongo_test"

# Long random string (at least 16 characters) used to sign staff sessions.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# The web app origin allowed by CORS (comma-separate several)
CORS_ORIGIN="http://localhost:5173"

# Base URL of the web app, used in patient links (QR code on the ticket, SMS)
PUBLIC_WEB_URL="http://localhost:5173"

PORT=4000
NODE_ENV="development"

# Pitch demo helpers (/api/dev/*: simulated SMS panel, advance, reset). Always on outside production.
DEMO_MODE="true"

# SMS. simulate = nothing is sent; messages appear in Staff > SMS messages.
SMS_MODE="simulate"
# For SMS_MODE=live: africastalking (default) or http (a generic aggregator)
SMS_PROVIDER="africastalking"
AT_USERNAME=""
AT_API_KEY=""
AT_SANDBOX="false"
SMS_HTTP_URL=""
SMS_HTTP_TOKEN=""
# Shared secret the provider must send with delivery reports and inbound SMS:
#   POST /api/sms/delivery?secret=...   POST /api/sms/inbound?secret=...
SMS_WEBHOOK_SECRET=""

# Background jobs (SMS outbox, daily close, retention) inside the API process
JOBS_ENABLED="true"
